# ─── 수집기 (GitHub Actions Secrets) ───
# 네이버 검색 API (없으면 구글만 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Gmail 발송 (2단계 인증 후 '앱 비밀번호' 발급해 사용)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# 수신자 (쉼표구분). 비우면 config.yaml의 recipients 사용
MAIL_TO=a@corp.com,b@corp.com

# ─── 웹 대시보드 (Vercel 환경변수) ───
SITE_PASSWORD=접속용_공유_비밀번호
AUTH_SECRET=길고_무작위한_서명키_32자이상
GITHUB_REPO=youruser/battery-news
GITHUB_BRANCH=main
# private 레포일 때만 (read 권한 PAT)
GITHUB_TOKEN=
